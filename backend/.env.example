GROQ_API_KEY=KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=postgresql://user:password@localhost:5432/careercompass
VECTOR_DB_PATH=./data/vector_store
MAX_AGENT_RETRIES=3

# --- Auth ---
# Paste your Google OAuth 2.0 Client ID here (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
# A random secret key for signing tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here
